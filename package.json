{
  "name": "testhub-ui-platform",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "auth": "node scripts/save-auth.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "test:features": "node --test checks/*.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "mysql2": "3.24.5",
    "typescript": "5.9.3"
  }
}
